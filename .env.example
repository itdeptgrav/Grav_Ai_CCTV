# Copy this file to .env and adjust. Never commit .env.

# ── web server ──────────────────────────────────────────────
CCTV_PORT=8000
# CCTV_TOKEN was the OLD ?key= gate — no longer used. Access is now via the
# GRAV CMS SSO flow (see below). Left here only for reference.
CCTV_TOKEN=change-me-to-a-strong-secret

# ── CCTV SSO (access via the GRAV CMS only) ─────────────────
# Shared HS256 secret. MUST match the CMS backend's CCTV_SSO_SECRET exactly.
# The CMS mints a 90s HS256 token and redirects to /sso; this app verifies it
# and sets a signed cctv_session cookie.
CCTV_SSO_SECRET=027f74118cdb6e0717769fc5eb8ebca1285cf9cf45b06e670fdf3de66c8792f5
# Public URL of this CCTV app (the CMS mint endpoint redirects here).
CCTV_APP_URL=https://cctv.grav.in
# Signed cctv_session cookie lifetime in seconds (default 8h = 28800 if unset).
CCTV_SESSION_TTL=28800

# ── stream quality / limits ─────────────────────────────────
CCTV_STREAM_W=640
CCTV_STREAM_H=360
CCTV_STREAM_FPS=8
CCTV_JPEG_QUALITY=70
CCTV_NVR_MAX_CONN=6
CCTV_IDLE_TIMEOUT=60

# ── startup / connect tuning (see FINAL_CCTV_PERFORMANCE_REPORT.txt) ──
# RTSP open/read timeout in ms. Keep ABOVE the slowest healthy cold open (nvr2
# substreams need up to ~7 s the first time) or real cameras get killed and waste
# a retry; this is what makes a truly-dead channel fail in ~8 s instead of ~30 s.
CCTV_OPEN_TIMEOUT_MS=8000
CCTV_READ_TIMEOUT_MS=8000
# Simultaneous RTSP opens allowed process-wide. OpenCV's FFmpeg backend serializes
# opens internally, so 1 is optimal (measured: higher gives no speed-up).
CCTV_CONNECT_MAX=1
# Set to 1 to print per-camera open / first-frame timings to stdout (diagnostics).
CCTV_DEBUG_TIMING=0

# ── persistent relay (see FINAL_CCTV_RELAY_REPORT.txt) ──────
# 1 (default) = keep up to the per-NVR cap of streams HOT 24/7 so viewers get
# live video instantly. Run it on ONE server only (production); set 0 on every
# other machine that runs server.py against the same NVRs.
CCTV_PERSISTENT=1
# Per-NVR cap overrides. Leave unset (= CCTV_NVR_MAX_CONN, verified-safe 6) until
# the supervised test (SUPERVISED_NVR_CAPACITY_TEST.txt) proves more is safe.
#CCTV_NVR1_MAX_CONN=6
#CCTV_NVR2_MAX_CONN=6
# JPEG rate of a HOT camera nobody is watching (saves CPU; viewers get full rate).
CCTV_IDLE_FPS=1
# A frame older than this is never shown as live (it is shown as "CACHED hh:mm:ss").
CCTV_LIVE_MAX_AGE_S=2.5
# Cached frames older than this are not shown at all (status card instead).
CCTV_CACHE_MAX_AGE_S=1800
# Cache refresh of cameras outside the HOT pool: one short visit per NVR at most
# every N s, only after N s without viewers on that NVR (0 = off).
CCTV_REFRESH_EVERY_S=300
CCTV_REFRESH_IDLE_S=60
# Listen address: 0.0.0.0 = LAN too; 127.0.0.1 = only this machine (e.g. behind a
# Cloudflare tunnel running on the same PC).
#CCTV_BIND=0.0.0.0

# ── video quality: Standard / Original (see FINAL_CCTV_QUALITY_MODE_REPORT.txt) ──
# NVR stream numbers (Dahua / CP Plus: 1 = sub-stream, 0 = main stream).
# Verified 2026-09-25: main stream = 2560x1440 on both NVRs.
#CCTV_STANDARD_SUBTYPE=1
#CCTV_ORIGINAL_SUBTYPE=0
# Original JPEG quality (50..95) and the fullscreen frame rate (grid tiles ask 6).
#CCTV_ORIGINAL_JPEG_QUALITY=90
#CCTV_ORIGINAL_FPS=12
# Original watched only in grid tiles: scaled DOWN to this width (never up).
# 0 = full source size in the grid too (~4x the bandwidth: 19-36 Mbps per tile).
#CCTV_ORIGINAL_GRID_MAX_W=1280
# Width cap for Original everywhere, fullscreen included (0 = keep the source size).
#CCTV_ORIGINAL_MAX_W=0

# ── live-stream stability (see FINAL_CCTV_STABILITY_REPORT.txt) ─────
# Quality switch is make-before-break: the old stream bridges until the new one is
# live, then is released. Safety cap for that bridge (seconds):
#CCTV_HANDOFF_MAX_S=60
# An Original stream stays up this long after its last viewer (a retry / reopen
# re-attaches without a new RTSP handshake); any viewer needing the slot takes it.
#CCTV_ORIGINAL_LINGER_S=5
# RTSP read timeout of the main stream (default = CCTV_READ_TIMEOUT_MS).
#CCTV_ORIGINAL_READ_TIMEOUT_MS=8000

# ── how the server reaches the NVRs ─────────────────────────
# auto  = LAN when the server is on the CCTV network, else public IP (default,
#         correct for a hosted server that is NOT on the camera LAN)
# lan   = always use the private NVR IPs below
# remote= always use CCTV_PUBLIC_IP + *_PUBLIC_PORT
CCTV_ACCESS_MODE=auto
CCTV_PUBLIC_IP=your.public.ip.here

# ── NVR 1 ───────────────────────────────────────────────────
NVR1_HOST=192.168.1.48
NVR1_PORT=554
NVR1_PUBLIC_PORT=10554
NVR1_USERNAME=your_nvr1_username
NVR1_PASSWORD=your_nvr1_password
NVR1_MAC=aa-bb-cc-dd-ee-ff

# ── NVR 2 ───────────────────────────────────────────────────
NVR2_HOST=192.168.1.44
NVR2_PORT=554
NVR2_PUBLIC_PORT=20554
NVR2_USERNAME=your_nvr2_username
NVR2_PASSWORD=your_nvr2_password
NVR2_MAC=aa-bb-cc-dd-ee-ff
