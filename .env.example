# Copy this file to .env and adjust. Never commit .env.

# ── web server ──────────────────────────────────────────────
CCTV_PORT=8000
# The ADMINISTRATORS' key link: https://cctv.grav.in/?key=<CCTV_TOKEN> = full access
# (every camera, sound, playback, camera Settings), no password. Share it with
# administrators only. Opened in a browser, the key is swapped at once for a signed
# cookie and removed from the address bar. Changing this value retires the old link and
# signs out every browser that opened it.
# Generate: python -c "import secrets; print('grav-cctv-' + secrets.token_urlsafe(18))"
CCTV_TOKEN=change-me-to-a-strong-secret

# ── per-person CCTV permissions: sign-in from the GRAV CMS ───
# Everybody else opens CCTV from the CMS: a 90-second HS256 token naming the person
# (GET /sso?token=...), then a signed cctv_session cookie; which cameras they see and
# live / audio / playback on each is asked of the CMS (Access control > People & roles).
# Both secrets MUST be identical on the CMS backend, at least 32 characters, and NEW
# (a published value is refused). Generate each: python -c "import secrets; print(secrets.token_hex(32))"
CCTV_SSO_SECRET=generate-a-new-64-hex-secret
CCTV_SERVICE_KEY=generate-another-new-64-hex-secret
# The CMS backend (permission checks) and the CMS web app (the "Open CCTV" links).
CCTV_CMS_API_URL=https://cms-api.example.grav.in
CCTV_CMS_APP_URL=https://cms.example.grav.in
# Public URL of this CCTV app (informational; the CMS backend has its own CCTV_APP_URL).
CCTV_APP_URL=https://cctv.grav.in
# Signed cctv_session cookie lifetime in seconds (default 8h = 28800 if unset).
CCTV_SESSION_TTL=28800
# A person's permissions are re-asked of the CMS after this many seconds (the CMS also
# pushes every change at once); open views are re-checked every 2 s.
#CCTV_PERMISSION_TTL_S=15
# If the CMS cannot be reached, the last answer is kept this long, then access is refused.
#CCTV_PERMISSION_GRACE_S=60

# ── stream quality / limits ─────────────────────────────────
CCTV_STREAM_W=640
CCTV_STREAM_H=360
CCTV_STREAM_FPS=8
CCTV_JPEG_QUALITY=70
CCTV_NVR_MAX_CONN=6
CCTV_IDLE_TIMEOUT=60

# ── startup / connect tuning (see FINAL_CCTV_PERFORMANCE_REPORT.txt) ──
# RTSP open/read timeout in ms. Keep ABOVE the slowest healthy cold open (nvr2
# substreams need up to ~7 s the first time) or real cameras get killed and waste
# a retry; this is what makes a truly-dead channel fail in ~8 s instead of ~30 s.
CCTV_OPEN_TIMEOUT_MS=8000
CCTV_READ_TIMEOUT_MS=8000
# Simultaneous RTSP opens allowed process-wide. OpenCV's FFmpeg backend serializes
# opens internally, so 1 is optimal (measured: higher gives no speed-up).
CCTV_CONNECT_MAX=1
# Set to 1 to print per-camera open / first-frame timings to stdout (diagnostics).
CCTV_DEBUG_TIMING=0

# ── persistent relay (see FINAL_CCTV_RELAY_REPORT.txt) ──────
# 1 (default) = keep up to the per-NVR cap of streams HOT 24/7 so viewers get
# live video instantly. Run it on ONE server only (production); set 0 on every
# other machine that runs server.py against the same NVRs.
CCTV_PERSISTENT=1
# Per-NVR cap overrides. Leave unset (= CCTV_NVR_MAX_CONN, verified-safe 6) until
# the supervised test (SUPERVISED_NVR_CAPACITY_TEST.txt) proves more is safe.
#CCTV_NVR1_MAX_CONN=6
#CCTV_NVR2_MAX_CONN=6
# JPEG rate of a HOT camera nobody is watching (saves CPU; viewers get full rate).
CCTV_IDLE_FPS=1
# A frame older than this is never shown as live (it is shown as "CACHED hh:mm:ss").
CCTV_LIVE_MAX_AGE_S=2.5
# Cached frames older than this are not shown at all (status card instead).
CCTV_CACHE_MAX_AGE_S=1800
# Cache refresh of cameras outside the HOT pool: one short visit per NVR at most
# every N s, only after N s without viewers on that NVR (0 = off).
CCTV_REFRESH_EVERY_S=300
CCTV_REFRESH_IDLE_S=60
# Listen address: 0.0.0.0 = LAN too; 127.0.0.1 = only this machine (e.g. behind a
# Cloudflare tunnel running on the same PC).
#CCTV_BIND=0.0.0.0

# ── video quality: Standard / Original (see FINAL_CCTV_QUALITY_MODE_REPORT.txt) ──
# NVR stream numbers (Dahua / CP Plus: 1 = sub-stream, 0 = main stream).
# Verified 2026-09-25: main stream = 2560x1440 on both NVRs.
#CCTV_STANDARD_SUBTYPE=1
#CCTV_ORIGINAL_SUBTYPE=0
# Original JPEG quality (50..95) and the fullscreen frame rate (grid tiles ask 6).
#CCTV_ORIGINAL_JPEG_QUALITY=90
#CCTV_ORIGINAL_FPS=12
# Original watched only in grid tiles: scaled DOWN to this width (never up).
# 0 = full source size in the grid too (~4x the bandwidth: 19-36 Mbps per tile).
#CCTV_ORIGINAL_GRID_MAX_W=1280
# Width cap for Original everywhere, fullscreen included (0 = keep the source size).
#CCTV_ORIGINAL_MAX_W=0

# ── live-stream stability (see FINAL_CCTV_STABILITY_REPORT.txt) ─────
# Quality switch is make-before-break: the old stream bridges until the new one is
# live, then is released. Safety cap for that bridge (seconds):
#CCTV_HANDOFF_MAX_S=60
# An Original stream stays up this long after its last viewer (a retry / reopen
# re-attaches without a new RTSP handshake); any viewer needing the slot takes it.
#CCTV_ORIGINAL_LINGER_S=5
# RTSP read timeout of the main stream (default = CCTV_READ_TIMEOUT_MS).
#CCTV_ORIGINAL_READ_TIMEOUT_MS=8000

# ── camera audio (see FINAL_CCTV_AUDIO_REPORT.txt) ──────────────
# 1 = offer camera audio (still OFF for every viewer until they click a speaker).
#CCTV_AUDIO=1
# Audio of a camera is its own audio-only NVR connection (counted in the per-NVR
# cap, opened only while someone listens): kept this long after the last listener,
# and at most this many at once per NVR.
#CCTV_AUDIO_LINGER_S=10
#CCTV_AUDIO_MAX_PER_NVR=2
# No audio RTP PACKET for this long = reconnect the audio (video is never touched).
# A silent microphone still sends packets: it shows "no sound detected", never reconnects.
# Default = the video read timeout (CCTV_READ_TIMEOUT_MS, 8 s).
#CCTV_AUDIO_READ_TIMEOUT_S=8
# "No sound detected" = no packet peaking above this level for this long.
#CCTV_AUDIO_SILENCE_DBFS=-60
#CCTV_AUDIO_SILENCE_S=3

# ── recorded playback (see FINAL_CCTV_PLAYBACK_REPORT.txt) ──────
# Cameras decoding recorded footage at the same time on THIS server. Each 1x
# playback decodes the NVR main stream (2560x1440 H.265): about one CPU core
# (measured on the i7-13620H dev laptop: 3 play smoothly, 4 fall behind).
# Measure on the production host before raising it.
#CCTV_PLAYBACK_MAX_WORKERS=3
# Playback sessions at the same time per NVR (proven: NVR1 2, NVR2 4). They count
# in the per-NVR connection cap together with live video and audio.
#CCTV_NVR1_PLAYBACK_MAX=2
#CCTV_NVR2_PLAYBACK_MAX=2
# How far back a search goes follows each NVR's OLDEST recording (the disks are full
# and overwrite the oldest footage; measured NVR1 ~27 days, NVR2 ~22.5 days). It is
# read at start and then every this many seconds (metadata only, ~1 request/camera).
#CCTV_PLAYBACK_RETENTION_REFRESH_S=1800
# Only while an NVR's oldest recording is not known yet (just after a start, NVR not
# answering): the longest From-To range of one search, in hours (31 days; the NVRs'
# recording search answered 30-day queries completely -- the old 24 h was ours).
#CCTV_PLAYBACK_MAX_RANGE_H=744
# A long range is searched in requests of at most this many hours (merged into one
# timeline) and played as NVR sessions of at most SESSION_SPAN_H (one NVR session covers
# at most ~58 h; playback moves to the next session by itself).
#CCTV_PLAYBACK_SEARCH_CHUNK_H=168
#CCTV_PLAYBACK_SESSION_SPAN_H=24
# The search reply waits this long; slower camera results reach the page afterwards.
#CCTV_PLAYBACK_SEARCH_WAIT_S=3
# Page closed -> playback stops after this; paused longer than PAUSE_HOLD_S ->
# the NVR session is closed (reopened at the same moment on Play).
#CCTV_PLAYBACK_GRACE_S=20
#CCTV_PLAYBACK_PAUSE_HOLD_S=60
# Pictures sent to the browser: grid tiles / one camera (full screen).
#CCTV_PLAYBACK_GRID_WIDTH=960
#CCTV_PLAYBACK_GRID_FPS=10
#CCTV_PLAYBACK_SINGLE_WIDTH=1280
#CCTV_PLAYBACK_SINGLE_FPS=12
#CCTV_PLAYBACK_JPEG_QUALITY=75
# FFmpeg threads per camera decoder (its default of one per CPU costs ~70% more
# CPU when several cameras play).
#CCTV_PLAYBACK_DECODE_THREADS=4
# A decoder this far behind (CPU too busy) skips ahead to the next key frame.
#CCTV_PLAYBACK_MAX_DECODE_LAG_S=3
# The NVRs' time zone in minutes (IST = 330). The playback URL uses NVR-local time,
# RTSP "Range: clock=" uses UTC; the NVR clocks themselves are not changed.
#CCTV_NVR_TZ_OFFSET_MIN=330

# ── how the server reaches the NVRs ─────────────────────────
# auto  = LAN when the server is on the CCTV network, else public IP (default,
#         correct for a hosted server that is NOT on the camera LAN)
# lan   = always use the private NVR IPs below
# remote= always use CCTV_PUBLIC_IP + *_PUBLIC_PORT
CCTV_ACCESS_MODE=auto
CCTV_PUBLIC_IP=your.public.ip.here

# ── NVR 1 ───────────────────────────────────────────────────
# Security: use a dedicated NVR account with ONLY live view + playback (replay)
# rights -- not an administrator account (Settings > Recorded playback warns).
NVR1_HOST=192.168.1.48
NVR1_PORT=554
NVR1_PUBLIC_PORT=10554
NVR1_USERNAME=your_nvr1_username
NVR1_PASSWORD=your_nvr1_password
NVR1_MAC=aa-bb-cc-dd-ee-ff

# ── NVR 2 ───────────────────────────────────────────────────
NVR2_HOST=192.168.1.44
NVR2_PORT=554
NVR2_PUBLIC_PORT=20554
NVR2_USERNAME=your_nvr2_username
NVR2_PASSWORD=your_nvr2_password
NVR2_MAC=aa-bb-cc-dd-ee-ff
